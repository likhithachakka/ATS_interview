# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma separated list of origins allowed by CORS (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Max resume upload size in megabytes
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local mongod:  mongodb://127.0.0.1:27017/interviewiq
# Atlas:         mongodb+srv://<user>:<password>@<cluster>/interviewiq?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/interviewiq

# ---------------------------------------------------------------------------
# Google Gemini (@google/genai SDK)
# Get a key from https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
